{
  "manifest_version": 3,
  "name": "Token Ledger — AI Usage Observer",
  "version": "1.0.0",
  "description": "Passively tracks your token usage across Claude, ChatGPT, and Gemini and emails you a daily report.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://api.emailjs.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    { "matches": ["https://claude.ai/*"], "js": ["content.js"], "run_at": "document_idle" },
    { "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle" },
    { "matches": ["https://gemini.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Token Ledger",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
